rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only access for MVP. Tighten before production.
    match /verses/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

